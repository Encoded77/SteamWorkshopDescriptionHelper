# Copy to .env and fill in. .env is gitignored.

# Path to your workshop-assets repo, relative to this directory or absolute.
# Defaults to ../workshop-assets.
SWDH_WORKSPACE=../workshop-assets

# Which mod folder inside the workspace to work on. Optional when the workspace
# holds only one; required once there are several.
SWDH_PROJECT=RimworldRebalancePatches

# GitHub token used to commit rendered PNGs to the workshop-assets repo.
#
# Use a fine-grained personal access token scoped to that ONE repository with
# "Contents: Read and write" — nothing else. The tool sends it only to
# api.github.com and never writes it to disk or logs.
GITHUB_TOKEN=

# Optional. Folder containing your RimWorld mods, so the editor can write a
# rendered preview to <Mod>/About/Preview.png. Leave unset and that action is
# disabled — nothing outside the workspace is mounted.
# SWDH_MODS=C:\Code
